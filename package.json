{
  "name": "@chronova/imagerouter-mcp",
  "version": "1.0.0",
  "description": "MCP server and local dashboard for generating images and videos through the ImageRouter API",
  "keywords": [
    "bun",
    "image-generation",
    "imagerouter",
    "mcp",
    "modelcontextprotocol",
    "video-generation"
  ],
  "homepage": "https://github.com/nx-solutions-ug/imagerouter-mcp#readme",
  "bugs": {
    "url": "https://github.com/nx-solutions-ug/imagerouter-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nx-solutions-ug/imagerouter-mcp.git"
  },
  "bin": {
    "imagerouter-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "start": "bun dist/cli.js",
    "dev": "bun --watch src/cli.ts",
    "dashboard": "bun run build && bun dist/cli.js dashboard",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --vitest-plugin --import-plugin",
    "lint:fix": "oxlint --vitest-plugin --import-plugin --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "semantic-release": "semantic-release",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "daisyui": "^5.7.47",
    "husky": "^9.1.7",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.4.2"
}
