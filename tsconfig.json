{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "bun"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist", "tests"]
}
